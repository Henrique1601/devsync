{$DEVSYNC_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    request_body {
        max_size 256KB
    }
    reverse_proxy coordinator:8787 {
        header_up Host {http.request.host}
    }
}
