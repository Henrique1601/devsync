# Copie para .env no servidor e use um token aleatório de pelo menos 32 caracteres.
# Gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEVSYNC_ADMIN_TOKEN=
# Apenas hostname: sem https://, porta ou caminho.
DEVSYNC_DOMAIN=devsync.example.com
ACME_EMAIL=you@example.com
