{
  "name": "devsync-local",
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "devsync": "./src/cli.js"
  },
  "main": "desktop/main.cjs",
  "description": "Sincronização Git entre computadores",
  "author": "Henrique Bezerra Dos Santos",
  "scripts": {
    "start": "node src/cli.js daemon",
    "test": "node --test",
    "devsync": "node src/cli.js",
    "mcp": "node src/cli.js mcp",
    "desktop": "electron .",
    "coordinator": "node src/cli.js coordinator",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "build": {
    "appId": "com.devsync.desktop",
    "productName": "DevSync",
    "files": [
      "desktop/**/*",
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "desktop/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "icon": "desktop/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DevSync Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "DevSync ${version} Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Henrique1601",
        "repo": "devsync"
      }
    ],
    "electronUpdaterCompatibility": ">= 2.16"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
