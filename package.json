{
  "name": "devsync-local",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "devsync": "./src/cli.js"
  },
  "main": "desktop/main.cjs",
  "description": "Sincronização Git entre computadores",
  "author": "DevSync",
  "scripts": {
    "start": "node src/cli.js daemon",
    "test": "node --test",
    "devsync": "node src/cli.js",
    "desktop": "electron .",
    "coordinator": "node src/cli.js coordinator",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "dist": "electron-builder --win nsis portable --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "build": {
    "appId": "com.devsync.desktop",
    "productName": "DevSync",
    "files": [
      "desktop/**/*",
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DevSync Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "DevSync ${version} Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Henrique1601",
        "repo": "devsync"
      }
    ],
    "electronUpdaterCompatibility": ">= 2.16"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
